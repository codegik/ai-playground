# Copy to .env and fill in. All three are read by the Claude Code CLI that the
# Agent SDK spawns — the SDK itself does not read them.

# Bearer-token auth: sent as `Authorization: Bearer <token>`. Use this when going
# through an LLM gateway/proxy. Takes precedence over the API key.
ANTHROPIC_AUTH_TOKEN=

# Endpoint override. Point this at your gateway when using a bearer token.
# ANTHROPIC_BASE_URL=https://your-gateway.example.com

# Direct Anthropic API auth (sent as `x-api-key`). Alternative to the bearer token.
# ANTHROPIC_API_KEY=

# Optional model override, e.g. claude-opus-4-8 or claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# If NONE of the above are set, the SDK falls back to the Claude Code CLI's own
# logged-in credentials (your Claude Pro/Max subscription) — so `make run` works
# out of the box if you're already logged into Claude Code.
