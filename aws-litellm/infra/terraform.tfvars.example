# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
aws_region     = "us-east-1"
openai_api_key = "sk-your-real-openai-key"

# Optional overrides:
# The master key is auto-generated at provision time. Set it only to pin a
# specific value; otherwise read it after apply with:
#   terraform output -raw litellm_master_key
# litellm_master_key  = "sk-litellm-master-change-me"
# litellm_model_alias = "gpt-4o-mini"
# openai_model        = "gpt-4o-mini"
# litellm_instance_type = "t3.small"
